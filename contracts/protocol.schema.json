{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "protocol.schema.json",
  "title": "ProtocolResponse",
  "description": "Daily activity protocol for a school based on current air quality.",
  "type": "object",
  "required": ["school_id", "date", "overall_status", "activities", "generated_at"],
  "properties": {
    "school_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date for this protocol."
    },
    "overall_status": {
      "$ref": "#/definitions/ProtocolStatus"
    },
    "overall_message": {
      "type": "string",
      "description": "Human-readable summary of the day's protocol."
    },
    "activities": {
      "type": "array",
      "items": { "$ref": "#/definitions/ActivityDecision" }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "definitions": {
    "ProtocolStatus": {
      "type": "string",
      "enum": ["all_clear", "caution", "restricted", "emergency"],
      "description": "Overall protocol status for the day."
    },
    "ActivityDecision": {
      "type": "object",
      "required": ["activity", "decision", "reason"],
      "properties": {
        "activity": {
          "type": "string",
          "description": "Name of the activity (e.g. 'Morning Assembly', 'PE Outdoor', 'Recess')."
        },
        "scheduled_time": {
          "type": "string",
          "description": "Scheduled time range (e.g. '08:00-08:30')."
        },
        "decision": {
          "$ref": "#/definitions/ActivityDecisionType"
        },
        "reason": {
          "type": "string",
          "description": "Explanation for the decision."
        },
        "alternative": {
          "type": "string",
          "description": "Suggested alternative if activity is restricted."
        }
      }
    },
    "ActivityDecisionType": {
      "type": "string",
      "enum": ["outdoors", "indoors", "restricted"],
      "description": "Whether the activity should be outdoors, moved indoors, or fully restricted."
    }
  }
}
