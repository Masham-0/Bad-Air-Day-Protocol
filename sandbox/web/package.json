{
  "name": "bad-air-day-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "sync-mock": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('../mocks/today-bundle.json','public/mock-today-bundle.json')\"",
    "dev": "npm run sync-mock && next dev",
    "build": "npm run sync-mock && next build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
