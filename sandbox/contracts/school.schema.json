{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "school.schema.json",
  "title": "School",
  "type": "object",
  "required": [
    "school_id",
    "name",
    "lat",
    "lon",
    "schedule"
  ],
  "additionalProperties": false,
  "properties": {
    "school_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "name_hi": {
      "type": "string"
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "district": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "alert_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      }
    },
    "schedule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slot_id",
          "label",
          "start",
          "end",
          "outdoor"
        ],
        "additionalProperties": false,
        "properties": {
          "slot_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "label_hi": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "IST wall-clock HH:MM"
          },
          "end": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
            "description": "IST wall-clock HH:MM"
          },
          "outdoor": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
